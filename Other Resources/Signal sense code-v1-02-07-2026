const int PIN_ON  = 1;   // ON terminal  (its COM -> GND)
const int PIN_OFF = 3;   // OFF terminal (its COM -> GND)

int lastOn = -1, lastOff = -1;

void setup() {
  Serial.begin(115200);
  pinMode(PIN_ON,  INPUT_PULLUP);
  pinMode(PIN_OFF, INPUT_PULLUP);
}

void loop() {
  int on  = digitalRead(PIN_ON);    // LOW = contact closed to COM
  int off = digitalRead(PIN_OFF);
  if (on != lastOn || off != lastOff) {
    Serial.printf("%lu ms  ON=%-6s  OFF=%-6s\n",
                  millis(),
                  on  == LOW ? "CLOSED" : "open",
                  off == LOW ? "CLOSED" : "open");
    lastOn = on; lastOff = off;
  }
  delayMicroseconds(500);           // ~2 kHz, won't miss a short make
}
