  .off{color:#e84040}
  .row{display:flex;gap:12px;width:100%;max-width:360px}
  .btn{flex:1;padding:14px;border:none;border-radius:10px;font-size:16px;
       font-weight:600;cursor:pointer;transition:opacity .15s}
  .btn:active{opacity:.75}
  .btn-on {background:#22d46a;color:#000}
  .btn-off{background:#e84040;color:#fff}
  .dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:6px;
       vertical-align:middle}
  .dot-on{background:#22d46a;box-shadow:0 0 6px #22d46a}
  .dot-off{background:#555}
</style>
</head>
<body>
<h1>&#9889; Contactor Control</h1>
<p class='sub'>192.168.4.1</p>

<div class='card'>
  <div class='label'>Relay state</div>
  <div class='value' id='relay'>--</div>
</div>

<div class='card'>
  <div class='label'>ZMPT1 &mdash; ON trigger</div>
  <div class='value' id='z1'>--</div>
</div>

<div class='card'>
  <div class='label'>ZMPT2 &mdash; OFF trigger</div>
  <div class='value' id='z2'>--</div>
</div>

<div class='row'>
  <button class='btn btn-on'  onclick="cmd('/on')">&#9654; Manual ON</button>
  <button class='btn btn-off' onclick="cmd('/off')">&#9646;&#9646; Manual OFF</button>
</div>

<script>
function dot(on){ return '<span class="dot '+(on?'dot-on':'dot-off')+'">\u200b</span>'; }

function update(d){
  var r=document.getElementById('relay');
  r.className='value '+(d.relay?'on':'off');
  r.innerHTML=dot(d.relay)+(d.relay?'ON':'OFF');

  var z1=document.getElementById('z1');
  z1.className='value '+(d.zmpt1?'on':'off');
  z1.innerHTML=dot(d.zmpt1)+(d.zmpt1?'AC Detected':'No Signal');

  var z2=document.getElementById('z2');
  z2.className='value '+(d.zmpt2?'on':'off');
  z2.innerHTML=dot(d.zmpt2)+(d.zmpt2?'AC Detected':'No Signal');
}

function poll(){ fetch('/status').then(r=>r.json()).then(update).catch(()=>{}); }
function cmd(url){ fetch(url).then(()=>poll()); }

