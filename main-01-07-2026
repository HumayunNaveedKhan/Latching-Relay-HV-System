/*
  Contactor latch controller with WiFi AP portal
  -----------------------------------------------
  GPIO1 = ZMPT1 OUT  (ON trigger,  200-250VAC)
  GPIO3 = ZMPT2 OUT  (OFF trigger, 200-250VAC)
  GPIO6 = Relay module IN (active-LOW)

  Logic:
    ZMPT1 detects AC  → relay latches ON
    ZMPT2 detects AC  → relay latches OFF
    Both quiet        → hold current state

  Portal: connect to WiFi "Contactor-Control" / 12345678
          open browser → 192.168.4.1
*/

#include <WiFi.h>
#include <WebServer.h>

// ---------- Pins ----------
#define ZMPT1_PIN   1
#define ZMPT2_PIN   3
#define RELAY_PIN   6

// ---------- Relay polarity ----------
// Most blue opto-isolated relay modules: LOW = coil energised
#define RELAY_ENERGISE   LOW
#define RELAY_DEENERGISE HIGH

// ---------- AC detection ----------
// Peak-to-peak ADC swing that counts as "AC present" (12-bit, 0-4095)
// With no AC the ZMPT output sits flat at its bias midpoint → tiny swing
// With 200-250VAC applied it swings widely.
// Start at 400, reduce if triggers are being missed, raise if noise triggers.
#define THRESHOLD 400
#define SAMPLE_MS  40    // 2× 50Hz cycle

// ---------- AP credentials ----------
const char* AP_SSID = "Contactor-Control";
const char* AP_PASS = "12345678";

WebServer server(80);

// ---------- State ----------
bool relayState   = false;
bool zmpt1Active  = false;
bool zmpt2Active  = false;

// ----------------------------------------
// Measure whether AC is present on a pin
// ----------------------------------------
bool acPresent(int pin) {
  int lo = 4095, hi = 0;
  unsigned long t = millis();
  while (millis() - t < SAMPLE_MS) {
    int v = analogRead(pin);
    if (v < lo) lo = v;
    if (v > hi) hi = v;
  }
  return (hi - lo) > THRESHOLD;
}

// ----------------------------------------
// Drive relay and update state variable
// ----------------------------------------
void setRelay(bool on) {
  relayState = on;
  digitalWrite(RELAY_PIN, on ? RELAY_ENERGISE : RELAY_DEENERGISE);
}

// ----------------------------------------
// Web portal HTML (single page, JS polls /status every 2 s)
// ----------------------------------------
void handleRoot() {
  server.send(200, "text/html", R"rawhtml(
<!DOCTYPE html><html>
<head>
<meta name='viewport' content='width=device-width,initial-scale=1'>
<title>Contactor</title>
<style>
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:sans-serif;background:#0f0f1a;color:#ddd;display:flex;
       flex-direction:column;align-items:center;padding:24px 16px;gap:16px}
  h1{font-size:22px;color:#fff;margin-bottom:4px}
  p.sub{font-size:13px;color:#777}
  .card{background:#1c1c30;border-radius:14px;padding:18px 24px;width:100%;max-width:360px}
  .label{font-size:12px;color:#888;text-transform:uppercase;letter-spacing:.5px;margin-bottom:6px}
  .value{font-size:26px;font-weight:600}
