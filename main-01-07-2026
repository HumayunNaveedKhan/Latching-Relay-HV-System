</script>
</body></html>
)rawhtml");
}

void handleStatus() {
  String j = "{\"relay\":";
  j += relayState  ? "true" : "false";
  j += ",\"zmpt1\":";
  j += zmpt1Active ? "true" : "false";
  j += ",\"zmpt2\":";
  j += zmpt2Active ? "true" : "false";
  j += "}";
  server.send(200, "application/json", j);
}

void handleOn()  { setRelay(true);  server.send(200, "text/plain", "ON");  }
void handleOff() { setRelay(false); server.send(200, "text/plain", "OFF"); }

// ----------------------------------------
void setup() {
  Serial.begin(115200);
  analogReadResolution(12);

  pinMode(RELAY_PIN, OUTPUT);
  setRelay(false);                      // start with contactor OFF

  WiFi.softAP(AP_SSID, AP_PASS);
  Serial.print("Portal ready → http://");
  Serial.println(WiFi.softAPIP());

  server.on("/",       handleRoot);
  server.on("/status", handleStatus);
  server.on("/on",     handleOn);
  server.on("/off",    handleOff);
  server.begin();
}

void loop() {
  server.handleClient();                // keep the web server alive

  zmpt1Active = acPresent(ZMPT1_PIN);  // ~40 ms each
  zmpt2Active = acPresent(ZMPT2_PIN);  // ~40 ms each

  // Latch logic — only act on a state change
  if (zmpt1Active && !relayState) setRelay(true);
  if (zmpt2Active &&  relayState) setRelay(false);
}
